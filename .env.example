GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_WIKI_ROOT=./data
LLM_WIKI_ENV_FILE=

# Capture API
CAPTURE_API_TOKEN=
CAPTURE_API_BIND_URL=http://127.0.0.1:5055

# CORS (브라우저 Extension 사용 시 필요)
# Development: AllowAnyOrigin/AllowAnyHeader/AllowAnyMethod
# 값 없음: CORS 비활성화 (curl 전용 운영 시)
CAPTURE_API_CORS_MODE=Development
CAPTURE_API_ALLOWED_ORIGINS=
